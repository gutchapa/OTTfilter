# MongoDB Configuration
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/
MONGO_URL=mongodb://localhost:27017
DB_NAME=ottfilter

# TMDB API Configuration
# Get your API key (Bearer token) from: https://www.themoviedb.org/settings/api
# This is the primary data source for movie information
TMDB_API_KEY=your_tmdb_bearer_token_here

# OMDb API Configuration
# Get your API key from: http://www.omdbapi.com/apikey.aspx
# Used for fetching IMDb ratings (Free tier: 1,000 requests/day)
OMDB_API_KEY=your_omdb_api_key_here

# YouTube Data API v3
# Get your API key from: https://console.cloud.google.com/
# Used for finding trailers and songs (Free tier: 10,000 units/day)
YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# Used for natural language query parsing (Paid service)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration (Optional)
# PORT=8001
# HOST=0.0.0.0
# WORKERS=4

# CORS Configuration (Optional)
# Set this to your frontend URL in production
# FRONTEND_URL=https://your-frontend-domain.com
